# Copy to .env (git-ignored): cp .env.example .env
# Every value below is a local-development placeholder, not a real credential.

# --- API: validated by apps/backend/src/config/config.ts
NODE_ENV=development
PORT=3001
# Must match the POSTGRES_* values below.
DATABASE_URL=postgresql://seo_audit:seo_audit_dev@localhost:5433/seo_audit

# --- Local PostgreSQL: read only by docker-compose.yml
POSTGRES_USER=seo_audit
POSTGRES_PASSWORD=seo_audit_dev
POSTGRES_DB=seo_audit
# Host port; 5433 avoids clashing with another local PostgreSQL on 5432.
POSTGRES_PORT=5433
