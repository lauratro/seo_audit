{
  "name": "seo-audit-tool",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build -w packages/shared",
    "pretypecheck": "npm run build -w packages/shared",
    "pretest": "npm run build -w packages/shared",
    "dev": "npm run dev -w apps/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
